{
  "name": "react-three-toggle",
  "version": "2.1.0",
  "description": "Multi-value toggle component for React. Click to cycle through three or more options with optional wrap and form integration.",
  "keywords": [
    "react",
    "toggle",
    "multi-toggle",
    "switch",
    "cycle",
    "headless"
  ],
  "license": "MIT",
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/react-three-toggle.git"
  },
  "homepage": "https://react-three-toggle.kkweb.io",
  "funding": "https://github.com/sponsors/piro0919",
  "bugs": {
    "url": "https://github.com/piro0919/react-three-toggle/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "default": "./dist/web-component.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/web-component.js"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:lib": "tsup && node scripts/build-web-component.mjs",
    "build:lib:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build:lib && pnpm run check:package",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints web-component"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@piro0919/eslint-config": "github:piro0919/eslint-config#v1.0.0",
    "@r2wc/react-to-web-component": "^2.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vercel/analytics": "2.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "lefthook": "^2.1.17",
    "next": "^16.4.0",
    "preact": "^11.0.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "packageManager": "pnpm@11.28.5"
}
